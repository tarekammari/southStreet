# South Street Server — Environment Configuration
# Copy this file to .env and fill in your values

# ──────────────────────────────────────────────
# SERVER
# ──────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ──────────────────────────────────────────────
# JWT SECRET (generate with: node -e "require('crypto').randomBytes(64).toString('hex')")
# CRITICAL: Change this before deploying!
# ──────────────────────────────────────────────
JWT_SECRET=CHANGE_THIS_TO_A_RANDOM_64_BYTE_HEX_STRING
JWT_EXPIRES_IN=24h

# ──────────────────────────────────────────────
# CORS — allowed frontend origins
# ──────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com

# ──────────────────────────────────────────────
# STUN/TURN for WebRTC NAT traversal
# Leave TURN blank to use Google STUN only (works on most networks)
# For production, set up Coturn:  https://github.com/coturn/coturn
# ──────────────────────────────────────────────
STUN_SERVER=stun:stun.l.google.com:19302
TURN_SERVER=
TURN_USERNAME=
TURN_CREDENTIAL=

# ──────────────────────────────────────────────
# ENCRYPTION
# AES-256-GCM key that wraps every TEXT field in SQLite.
# If this secret is lost, stored data cannot be recovered.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ──────────────────────────────────────────────
DB_ENCRYPTION_SECRET=CHANGE_THIS_TO_A_RANDOM_32_BYTE_HEX_STRING
DB_LOOKUP_SECRET=CHANGE_THIS_TO_ANOTHER_RANDOM_32_BYTE_HEX_STRING
SERVER_ENCRYPTION_KEY=CHANGE_THIS_TO_A_RANDOM_32_BYTE_HEX_STRING

# ──────────────────────────────────────────────
# DATABASE
# ──────────────────────────────────────────────
DB_PATH=./south_street.db

# ──────────────────────────────────────────────
# SAKHR AI — External fallback (Google Gemini)
# Get a free key: https://aistudio.google.com/apikey
# ──────────────────────────────────────────────
GEMINI_API_KEY=
# Alternative name (optional):
# SAKHR_GEMINI_KEY=

# ──────────────────────────────────────────────
# VERCEL / SERVERLESS (optional)
# ──────────────────────────────────────────────
# On Vercel the app uses /tmp/south_street.db automatically.
# Set DB_PATH only if you mount persistent storage elsewhere.
# DB_PATH=/tmp/south_street.db
#
# Required on Vercel (Settings → Environment Variables → Production + Preview):
#   JWT_SECRET=<random 64-byte hex>
#   DB_ENCRYPTION_SECRET=<random 32-byte hex>
#   DB_LOOKUP_SECRET=<random 32-byte hex>
#   NEXT_PUBLIC_GOOGLE_CLIENT_ID=<your-client-id.apps.googleusercontent.com>
#   GOOGLE_CLIENT_ID=<same as above>
#
# After deploy, default admin (fresh DB): username admin / password Admin@2026!
# Admin roles also need security key text: SOUTHSTREET-KEY-v1-9F8E7D6C5B4A3928
# Add https://south-street-wine.vercel.app to Google OAuth authorized origins.
# Create an OAuth client ID: https://console.cloud.google.com/apis/credentials
# Authorized JavaScript origins (add all, same Client ID):
#   http://localhost:3000
#   http://127.0.0.1:3000
#   https://south-street-wine.vercel.app
# Later custom domain: add https://your-domain.com to the SAME client.
# On Vercel, set both variables below (Production + Preview), then redeploy.
# ──────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=

AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MS=900000
