# South Street Server — Environment Configuration
# Copy this file to .env and fill in your values

# ──────────────────────────────────────────────
# SERVER
# ──────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ──────────────────────────────────────────────
# JWT SECRET (generate with: node -e "require('crypto').randomBytes(64).toString('hex')")
# CRITICAL: Change this before deploying!
# ──────────────────────────────────────────────
JWT_SECRET=CHANGE_THIS_TO_A_RANDOM_64_BYTE_HEX_STRING
JWT_EXPIRES_IN=24h

# ──────────────────────────────────────────────
# CORS — allowed frontend origins
# ──────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com

# ──────────────────────────────────────────────
# STUN/TURN for WebRTC NAT traversal
# Leave TURN blank to use Google STUN only (works on most networks)
# For production, set up Coturn:  https://github.com/coturn/coturn
# ──────────────────────────────────────────────
STUN_SERVER=stun:stun.l.google.com:19302
TURN_SERVER=
TURN_USERNAME=
TURN_CREDENTIAL=

# ──────────────────────────────────────────────
# ENCRYPTION
# Server-side encryption key for audit logs (32 bytes hex)
# (Messages are E2E encrypted client-side — server CANNOT decrypt them)
# ──────────────────────────────────────────────
SERVER_ENCRYPTION_KEY=CHANGE_THIS_TO_A_RANDOM_32_BYTE_HEX_STRING

# ──────────────────────────────────────────────
# DATABASE
# ──────────────────────────────────────────────
DB_PATH=./south_street.db

# ──────────────────────────────────────────────
# RATE LIMITING
# ──────────────────────────────────────────────
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MS=900000
