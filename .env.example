# South Street Server — Environment Configuration
# Copy this file to .env and fill in your values

# ──────────────────────────────────────────────
# SERVER
# ──────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ──────────────────────────────────────────────
# JWT SECRET (generate with: node -e "require('crypto').randomBytes(64).toString('hex')")
# CRITICAL: Change this before deploying!
# ──────────────────────────────────────────────
JWT_SECRET=CHANGE_THIS_TO_A_RANDOM_64_BYTE_HEX_STRING
JWT_EXPIRES_IN=24h

# ──────────────────────────────────────────────
# CORS — allowed frontend origins
# ──────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com

# ──────────────────────────────────────────────
# STUN/TURN for WebRTC NAT traversal
# Leave TURN blank to use Google STUN only (works on most networks)
# For production, set up Coturn:  https://github.com/coturn/coturn
# ──────────────────────────────────────────────
STUN_SERVER=stun:stun.l.google.com:19302
TURN_SERVER=
TURN_USERNAME=
TURN_CREDENTIAL=

# ──────────────────────────────────────────────
# ENCRYPTION
# AES-256-GCM key that wraps every TEXT field in SQLite.
# If this secret is lost, stored data cannot be recovered.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ──────────────────────────────────────────────
DB_ENCRYPTION_SECRET=CHANGE_THIS_TO_A_RANDOM_32_BYTE_HEX_STRING
DB_LOOKUP_SECRET=CHANGE_THIS_TO_ANOTHER_RANDOM_32_BYTE_HEX_STRING
SERVER_ENCRYPTION_KEY=CHANGE_THIS_TO_A_RANDOM_32_BYTE_HEX_STRING

# ──────────────────────────────────────────────
# DATABASE
# ──────────────────────────────────────────────
DB_PATH=./south_street.db

# ──────────────────────────────────────────────
# SAKHR AI — External fallback (Pollinations → Gemini → xAI → local FAQ)
# SAKHR_AI_PROVIDER=auto|pollinations|gemini|xai  (default: auto)
# auto order:
#   1) Pollinations when POLLINATIONS_ENABLED=true (free; optional key)
#   2) Google Gemini if GEMINI_API_KEY / SAKHR_GEMINI_KEY set
#   3) xAI Grok if XAI_API_KEY / GROK_API_KEY set (optional)
#   4) Built-in local FAQ / soft Arabic guidance
# Pollinations: https://text.pollinations.ai  |  keyed: https://enter.pollinations.ai
# Gemini: https://aistudio.google.com/apikey
# ──────────────────────────────────────────────
POLLINATIONS_ENABLED=true
# Optional free/registered key if legacy anonymous endpoints return 402:
# POLLINATIONS_API_KEY=
# POLLINATIONS_MODEL=openai
SAKHR_AI_PROVIDER=auto
GEMINI_API_KEY=
# SAKHR_GEMINI_KEY=
# XAI_API_KEY=
# GROK_API_KEY=
# ──────────────────────────────────────────────
# VERCEL / SERVERLESS (optional)
# ──────────────────────────────────────────────
# On Vercel the app uses /tmp/south_street.db automatically.
# Set DB_PATH only if you mount persistent storage elsewhere.
# DB_PATH=/tmp/south_street.db
#
# Required on Vercel (Settings → Environment Variables → Production + Preview):
#   JWT_SECRET=<random 64-byte hex>
#   DB_ENCRYPTION_SECRET=<random 32-byte hex>
#   DB_LOOKUP_SECRET=<random 32-byte hex>
#   NEXT_PUBLIC_GOOGLE_CLIENT_ID=<your-client-id.apps.googleusercontent.com>
#   GOOGLE_CLIENT_ID=<same as above>
#
# After deploy, default admin (fresh DB): username admin / password Admin@2026!
# Admin roles also need security key text: SOUTHSTREET-KEY-v1-9F8E7D6C5B4A3928
# Add https://south-street-wine.vercel.app to Google OAuth authorized origins.
# Create an OAuth client ID: https://console.cloud.google.com/apis/credentials
# Authorized JavaScript origins (add all, same Client ID):
#   http://localhost:3000
#   http://127.0.0.1:3000
#   https://south-street-wine.vercel.app
# Later custom domain: add https://your-domain.com to the SAME client.
# On Vercel, set both variables below (Production + Preview), then redeploy.
# ──────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=

AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MS=900000

# ============================================================================
# PILGRIM UX FLAGS (safe defaults — no live card pay)
# ============================================================================
# When false (default): new Google / self-serve pilgrims are APPROVED and get a session immediately.
# When true: keep classic PENDING_APPROVAL until an admin approves.
REQUIRE_ADMIN_APPROVAL_FOR_NEW_USERS=false

# When false (default): "Pay by card (Stripe / CIB)" stays disabled with Coming soon.
# When true: enable the CTA only after you wire a real provider (see docs/ONLINE_CARD_PAY.md).
ONLINE_CARD_PAY_ENABLED=false

# DEMO / QA LOGINS (placeholders only — change in real deploys)
# Agents do NOT use a .key file. File key is SUPER_ADMIN / AGENCY_MANAGER only.
#   agent@southstreet.dz  /  Agent@2026!   -> AGENCY_AGENT -> /portal (no firewall)
#   accountant@southstreet.dz / Accountant@2026!
#   guide@southstreet.dz / Guide@2026!

# --- Admin security (Super Admin / Admin sign-in with hardware security keys) ---
# Security keys are bound to the domain. Required in production (HTTPS):
#   WEBAUTHN_RP_ID=southstreet.dz
#   WEBAUTHN_ORIGINS=https://southstreet.dz,https://www.southstreet.dz
WEBAUTHN_RP_ID=
WEBAUTHN_ORIGINS=
# Base URL printed in activation links (defaults to the first WEBAUTHN_ORIGINS entry)
APP_ORIGIN=
# Shared secret between the middleware and /api/security/ingest (random, 32+ bytes)
SECURITY_INGEST_TOKEN=
# JWT_SECRET must be at least 32 characters; the server refuses to start sessions without it in production.
