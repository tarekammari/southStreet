# Copy to .env (never commit .env).
NODE_ENV=production
PORT=3300
HOST=127.0.0.1
APP_NAME=Mobilo
PUBLIC_URL=https://mobile.1zayd1.tech
DATA_DIR=/var/lib/mobile-store
# Long random string: openssl rand -hex 32
APP_SECRET=
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application)
#   Authorised redirect URI: https://mobile.1zayd1.tech/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Platform owners (comma separated Google e-mails)
SUPER_ADMIN_EMAILS=
TRIAL_DAYS=30
MAX_STORES_PER_USER=3
# subdomain (https://<slug>.mobile.1zayd1.tech) or path (https://mobile.1zayd1.tech/s/<slug>/)
STORE_URL_MODE=subdomain
